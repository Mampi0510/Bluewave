<Page x:Class="BlueWave.Views.Produit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      KeepAlive="True">

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Produits" FontSize="24"
                       FontWeight="Bold" Foreground="#0D2137"/>
            <TextBlock Text="Gestion du catalogue produits"
                       Foreground="#607D8B" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Formulaire ajout -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="5">
                            <TextBox Height="35" VerticalContentAlignment="Center"
                                     Text="{Binding NomProduit, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Nom du produit" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NomProduit}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NomProduit}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="1" Margin="5">
                            <TextBox Height="35" VerticalContentAlignment="Center"
                                     Text="{Binding Prix, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Prix" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Prix}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2" Content="+ Ajouter" Margin="5"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding AddCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding MErrorMessage}" Foreground="Red" Margin="5,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- DataGrid + Sidebar -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DataGrid -->
                <DataGrid Grid.Column="0"
                          Style="{StaticResource StyledDataGrid}"
                          ItemsSource="{Binding Produits}"
                          SelectedItem="{Binding SelectedProduit}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource StyledDataGridColumnHeader}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource StyledDataGridCell}"/>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource StyledDataGridRow}"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CodeProduit}" Width="60"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding NomProduit}" Width="*"/>
                        <DataGridTextColumn Header="Prix (Ar)" Binding="{Binding Prix}" Width="100"/>
                        <DataGridTemplateColumn Header="Action" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Modifier"
                                                Margin="0,0,5,0"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Command="{Binding DataContext.EditCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Supprimer"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- SIDEBAR -->
                <Border Grid.Column="1"
                        Width="280" Margin="15,0,0,0"
                        Background="White" CornerRadius="12" Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.08"
                                          ShadowDepth="2" Direction="270"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Modifier le produit"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#0D2137" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Content="✕" Width="24" Height="24"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#9E9E9E" FontSize="12" Padding="0"
                                    Command="{Binding CancelEditCommand}"/>
                        </Grid>

                        <TextBlock Text="Nom du produit" FontSize="11"
                                   Foreground="#607D8B" Margin="0,0,0,4"/>
                        <TextBox Height="35" VerticalContentAlignment="Center"
                                 Margin="0,0,0,12"
                                 Text="{Binding EditNomProduit, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Prix (Ar)" FontSize="11"
                                   Foreground="#607D8B" Margin="0,0,0,4"/>
                        <TextBox Height="35" VerticalContentAlignment="Center"
                                 Margin="0,0,0,20"
                                 Text="{Binding EditPrix, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="✔ Enregistrer"
                                Style="{StaticResource ActionButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveEditCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>