<Page x:Class="BlueWave.Views.GestionCommerciale"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      KeepAlive="True">

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Gestion Commerciale" FontSize="24"
                       FontWeight="Bold" Foreground="#0D2137"/>
            <TextBlock Text="Suivi des flux d'approvisionnement"
                       Foreground="#607D8B" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </TabControl.Resources>

            <!-- APPROVISIONNEMENT -->
            <TabItem Header="Approvisionnement">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Certificat -->
                                <Grid Grid.Column="0" Margin="5">
                                    <TextBox Height="35" VerticalContentAlignment="Center"
                                             Text="{Binding ApproVm.Certificat, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Certificat" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApproVm.Certificat}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ApproVm.Certificat}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Fournisseur -->
                                <Grid Grid.Column="1" Margin="5">
                                    <ComboBox Height="35"
                                              ItemsSource="{Binding ApproVm.Fournisseurs}"
                                              DisplayMemberPath="NomFournisseur"
                                              SelectedItem="{Binding ApproVm.SelectedFournisseur}"/>
                                    <TextBlock Text="Fournisseur" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApproVm.SelectedFournisseur}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Produit -->
                                <Grid Grid.Column="2" Margin="5">
                                    <ComboBox Height="35"
                                              ItemsSource="{Binding ApproVm.Produits}"
                                              DisplayMemberPath="NomProduit"
                                              SelectedItem="{Binding ApproVm.SelectedProduit}"/>
                                    <TextBlock Text="Produit" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApproVm.SelectedProduit}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Stock -->
                                <Grid Grid.Column="3" Margin="5">
                                    <ComboBox Height="35"
                                              ItemsSource="{Binding ApproVm.Stocks}"
                                              DisplayMemberPath="NomStock"
                                              SelectedItem="{Binding ApproVm.SelectedStock}"/>
                                    <TextBlock Text="Stock" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApproVm.SelectedStock}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Quantité -->
                                <Grid Grid.Column="4" Margin="5">
                                    <TextBox Height="35" VerticalContentAlignment="Center"
                                             Text="{Binding ApproVm.Quantite, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Quantité" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ApproVm.Quantite}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="5" Content=" Ajouter" Margin="5"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ApproVm.AddCommand}"/>
                            </Grid>

                            <TextBlock Text="{Binding ApproVm.MErrorMessage}"
                                       Foreground="Red" Margin="5,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApproVm.MErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ApproVm.MErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid + Sidebar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  Style="{StaticResource StyledDataGrid}"
                                  ItemsSource="{Binding ApproVm.Approvisionnements}"
                                  SelectedItem="{Binding ApproVm.SelectedApprovisionnement}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource StyledDataGridColumnHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell"
                                       BasedOn="{StaticResource StyledDataGridCell}"/>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"
                                       BasedOn="{StaticResource StyledDataGridRow}"/>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdApp}" Width="50"/>
                                <DataGridTextColumn Header="Certificat" Binding="{Binding Certificat}" Width="100"/>
                                <DataGridTextColumn Header="Fournisseur" Binding="{Binding Fournisseur.NomFournisseur}" Width="*"/>
                                <DataGridTextColumn Header="Produit" Binding="{Binding Produit.NomProduit}" Width="*"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock.NomStock}" Width="*"/>
                                <DataGridTextColumn Header="Quantité" Binding="{Binding Quantite}" Width="80"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateReception, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTemplateColumn Header="Action" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="3">
                                                <Button Content="Modifier"
                                                        Margin="0,0,5,0"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Command="{Binding DataContext.ApproVm.EditCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Supprimer"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.ApproVm.DeleteCommand,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- SIDEBAR -->
                        <Border Grid.Column="1" Width="280" Margin="15,0,0,0"
                                Background="White" CornerRadius="12" Padding="20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApproVm.IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.08"
                              ShadowDepth="2" Direction="270"/>
                            </Border.Effect>

                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Modifier l'approvisionnement"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#0D2137" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Content="✕"
                        Width="24" Height="24"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#9E9E9E" FontSize="12" Padding="0"
                        Command="{Binding ApproVm.CancelEditCommand}"/>
                                </Grid>

                                <TextBlock Text="Certificat" FontSize="11"
                       Foreground="#607D8B" Margin="0,0,0,4"/>
                                <TextBox Height="35" VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     Text="{Binding ApproVm.EditCertificat, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Quantité" FontSize="11"
                       Foreground="#607D8B" Margin="0,0,0,4"/>
                                <TextBox Height="35" VerticalContentAlignment="Center"
                     Margin="0,0,0,20"
                     Text="{Binding ApproVm.EditQuantite, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="✔ Enregistrer"
                    Style="{StaticResource ActionButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApproVm.SaveEditCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- COMMANDES -->
            <TabItem Header="Commandes Export">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Nouvelle commande" Foreground="#607D8B"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <!-- LIGNE 1 : Client / Destination / Délai -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="5">
                                    <ComboBox Height="35"
                          ItemsSource="{Binding CommandeVm.Clients}"
                          DisplayMemberPath="NomClient"
                          SelectedItem="{Binding CommandeVm.SelectedClient}"/>
                                    <TextBlock Text="Sélectionner un client" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandeVm.SelectedClient}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Column="1" Margin="5">
                                    <TextBox Height="35" VerticalContentAlignment="Center"
                         Text="{Binding CommandeVm.Destination, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Destination" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandeVm.Destination}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CommandeVm.Destination}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Column="2" Margin="5">
                                    <TextBox Height="35" VerticalContentAlignment="Center"
                         Text="{Binding CommandeVm.Delai, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Délai (j)" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandeVm.Delai}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <!-- LIGNE 2 : Produit / Quantité / Bouton ajouter au panier -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="5">
                                    <ComboBox Height="35"
                          ItemsSource="{Binding CommandeVm.Produits}"
                          DisplayMemberPath="NomProduit"
                          SelectedItem="{Binding CommandeVm.SelectedProduit}"/>
                                    <TextBlock Text="Sélectionner un produit" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandeVm.SelectedProduit}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Column="1" Margin="5">
                                    <TextBox Height="35" VerticalContentAlignment="Center"
                         Text="{Binding CommandeVm.QuantiteAchat, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Quantité" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0" Foreground="#9E9E9E">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandeVm.QuantiteAchat}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="2" Content=" Produit" Margin="5"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CommandeVm.AddAuPanierCommand}"/>
                            </Grid>

                            <!-- PANIER -->
                            <ItemsControl ItemsSource="{Binding CommandeVm.Panier}" Margin="5,0,5,8">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandeVm.Panier.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F0F7FF" CornerRadius="4" Padding="10,5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NomProduit}"
                                       VerticalAlignment="Center" FontSize="12" Foreground="#0D2137"/>
                                                <TextBlock Grid.Column="1"
                                       Text="{Binding Quantite, StringFormat='Qté : {0}'}"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="#607D8B" HorizontalAlignment="Right"/>
                                                <Button Grid.Column="2" Content="✕" Width="20" Height="20"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#E53935" FontSize="10" Padding="0"
                                    Command="{Binding DataContext.CommandeVm.RetirerDuPanierCommand,
                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Séparateur + bouton créer -->
                            <Border BorderBrush="#E8ECF0" BorderThickness="0,1,0,0" Margin="5,0,5,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0">
                                <Button Content=" Créer la commande"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding CommandeVm.AddCommand}"/>
                            </StackPanel>

                            <!-- Message erreur -->
                            <TextBlock Text="{Binding CommandeVm.MErrorMessage}"
                   Foreground="Red" Margin="5,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandeVm.MErrorMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CommandeVm.MErrorMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource StyledDataGrid}"
                              ItemsSource="{Binding CommandeVm.Commandes}"
                              SelectedItem="{Binding CommandeVm.SelectedCommande}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource StyledDataGridColumnHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource StyledDataGridCell}"/>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource StyledDataGridRow}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding NumeroCommande}" Width="60"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding Client.NomClient}" Width="*"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                            <DataGridTextColumn Header="Délai (j)" Binding="{Binding Delai}" Width="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateCommande, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTemplateColumn Header="Action" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Facture"
                                                    Margin="0,0,5,0"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Command="{Binding DataContext.CommandeVm.GenererFactureCommand,
                                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Supprimer"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.CommandeVm.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>